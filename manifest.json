{
  "manifest_version": 3,
  "name": "Calaméo PDF Export",
  "short_name": "Calaméo PDF",
  "version": "0.4.0",
  "description": "Télécharge le PDF complet d'une publication Calaméo ou l'imprime depuis le navigateur.",
  "minimum_chrome_version": "121",
  "permissions": [
    "downloads",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://*.calameoassets.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.calameo.com/read/*",
        "https://calameo.com/read/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "print.html",
        "print.js"
      ],
      "matches": [
        "https://www.calameo.com/*",
        "https://calameo.com/*"
      ]
    }
  ]
}
